{
  "name": "minecraft-survival-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Mineflayer-based Minecraft survival agent that runs alongside PCL2 (Plain Craft Launcher 2)",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node scripts/run-all.js",
    "agent": "node src/index.js",
    "agent:day": "node src/index.js --day",
    "server:setup": "node scripts/setup-server.js",
    "server": "node scripts/run-all.js --no-server",
    "pcl:client": "node scripts/launch-client.js",
    "pcl:info": "node scripts/pcl-info.js",
    "selftest": "node scripts/selftest.js",
    "inspect": "node scripts/inspect-world.js",
    "diagnose": "node src/index.js --diagnose --no-status",
    "probe": "node scripts/probe.js",
    "bridge": "node scripts/bridge-client.js health",
    "bridge:state": "node scripts/bridge-client.js state",
    "forge:test": "node scripts/test-forge.js",
    "inspect:server": "node scripts/inspect-server.js",
    "mods:report": "node scripts/mods-report.js",
    "mods:live": "node scripts/mods-report.js --live",
    "verify:modded": "node scripts/verify-modded.js",
    "body:info": "node scripts/body-info.js",
    "agent:mock": "node src/index.js --body mock --no-status",
    "client:launch": "node scripts/launch-forge-client.js",
    "client:check": "node scripts/client-check.js",
    "client:test": "node scripts/test-clientmod-protocol.js",
    "client:verify": "node scripts/client-verify.js",
    "client:build": "cd mod-client && gradlew.bat build --offline",
    "client:install": "node scripts/install-client-mod.js",
    "client:srg": "node scripts/gen-srg-names.js",
    "path:test": "node scripts/path-test.js",
    "tasks:test": "node scripts/tasks-test.js",
    "skills:test": "node scripts/skills-test.js",
    "control:test": "node scripts/control-test.js",
    "llm:dry": "node scripts/llm-dry.js",
    "p0:verify": "node scripts/p0-verify.js",
    "personal:test": "node scripts/personal-test.js",
    "plan:audit": "node scripts/plan-audit.js",
    "doctor": "node scripts/agent-doctor.js",
    "agent:client": "node src/index.js --body clientmod --profile simpfun",
    "play": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1",
    "play:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File stop.ps1"
  },
  "keywords": [
    "mineflayer",
    "minecraft",
    "agent",
    "survival",
    "pcl2",
    "automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "minecrafthawkeye": "^1.3.9",
    "mineflayer": "^4.39.0",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-tool": "^1.2.0",
    "prismarine-item": "^1.18.0",
    "prismarine-recipe": "^1.5.0",
    "socks": "^2.8.10",
    "vec3": "^0.2.0"
  }
}
