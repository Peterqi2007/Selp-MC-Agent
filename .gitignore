# Node dependencies
node_modules/

# Scratch space (extracted session archives, temp files)
.tmp/

# Third-party reference checkouts (mc_aiplayer / mindcraft / minecraft-numen / Voyager) -
# kept locally on purpose, but they are not part of this repository's history.
# NOTE: `refs/` already covers every future checkout, so a new project (e.g. refs/Voyager)
# needs no new line here - it is ignored the moment it is cloned.
# The two reference papers live there too (moved out of docs/ on 2026-10-31 to drop 28 MB
# of PDFs from history going forward): refs/Voyager/voyager.pdf,
# refs/MC-MineEvolve/MineEvolve.pdf
refs/

# Runtime state, downloaded servers, logs, traces
runtime/
logs/
ui.json

# Gradle build outputs and caches
mod-client/build/
mod-client/.gradle/
mod-client/run/
mod-bridge/build/
mod-bridge/.gradle/
mod-bridge/run/
# Generated compile-classpath dump (absolute paths from whoever built it)
mod-bridge/verify/cp.txt
mod-bridge/verify/raw.txt

# Stray log files
*.log

# IDE
.idea/

# ---------------------------------------------------------------------------
# CREDENTIALS - never commit these
# ---------------------------------------------------------------------------
# Put keys in config/*.local.json (untracked overlay, merged over the tracked
# config) or in the environment (LLM_API_KEY). Never in a tracked json file.
# config/llm.json and config/agent.json ship with empty credential fields on
# purpose; the overlay keeps your own values out of git without changing how
# start.ps1 works.
.env
.env.*
!.env.example
config/*.local.json
config/llm.local.json
config/servers.local.json
*.secrets.json

# Local-only launcher/toolchain paths
mod-*/local.properties
mod-*/gradle.properties.local
