-function shotName(windowId: number, index: number): string {
-  return `computer-use-${safeToken(String(windowId), 'window')}-${index}.png`
+function shotName(windowId: number, index: number, mediaType: ImageMediaType = 'image/png'): string {
+  const extension = mediaType === 'image/jpeg' ? 'jpg' : mediaType === 'image/webp' ? 'webp' : 'png'
+  return `computer-use-${safeToken(String(windowId), 'window')}-${index}.${extension}`
+}
+
+/** Prefer the bytes' real signature when a helper labels a screenshot incorrectly. */
+function sniffImageMediaType(data: Uint8Array): ImageMediaType | null {
+  if (data.length >= 8 && data[0] === 0x89 && data[1] === 0x50 && data[2] === 0x4e && data[3] === 0x47) {
+    return 'image/png'
+  }
+  if (data.length >= 3 && data[0] === 0xff && data[1] === 0xd8 && data[2] === 0xff) {
+    return 'image/jpeg'
+  }
+  if (
+    data.length >= 12 &&
+    String.fromCharCode(data[0], data[1], data[2], data[3]) === 'RIFF' &&
+    String.fromCharCode(data[8], data[9], data[10], data[11]) === 'WEBP'
+  ) {
+    return 'image/webp'
+  }
+  return null
 }
 
-/** 把 `data:image/png;base64,...` 解回字节。 */
-function decodeDataUrl(url: string): Uint8Array {
+/**
+ * Decode a screenshot data URL and keep its real media type.
+ *
+ * The helper has returned JPEG bytes for a Minecraft/OpenGL window even though the old
+ * implementation hard-coded `image/png`; the attachment store then rejected the upload with
+ * "Declared image type does not match its bytes." Parse the header, normalize `image/jpg`,
+ * and prefer the byte signature when the two disagree.
+ */
+function decodeDataUrl(url: string): { data: Uint8Array; mediaType: ImageMediaType } {
+  if (!url.startsWith('data:')) throw new Error('截图数据不是合法的 data URL')
   const comma = url.indexOf(',')
   if (comma === -1) throw new Error('截图数据不是合法的 data URL')
-  return new Uint8Array(Buffer.from(url.slice(comma + 1), 'base64'))
+  const header = url.slice(5, comma)
+  const declared = (header.split(';')[0] || 'image/png').toLowerCase().replace('image/jpg', 'image/jpeg')
+  if (declared !== 'image/png' && declared !== 'image/jpeg' && declared !== 'image/webp') {
+    throw new Error(`不支持的截图 mediaType: ${declared}`)
+  }
+  const data = new Uint8Array(
+    Buffer.from(url.slice(comma + 1), /;base64/i.test(header) ? 'base64' : 'utf8'),
+  )
+  if (data.length === 0) throw new Error('截图数据为空')
+  return { data, mediaType: sniffImageMediaType(data) ?? (declared as ImageMediaType) }
 }
